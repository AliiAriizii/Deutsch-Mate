# Normalise line endings so a Windows checkout does not rewrite every file.
* text=auto eol=lf

# Windows-native tooling expects CRLF in these.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.mp3  binary
*.m4a  binary
*.wav  binary
*.jar  binary
*.keystore binary
*.jks  binary
