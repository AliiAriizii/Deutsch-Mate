# Local development only. On Vercel these are set in Project Settings >
# Environment Variables, never in a file — see docs/DEPLOY_BACKEND.md.

# --- Mongo ---
# Local mongod already running as a Windows service on 27017 (no auth).
# On Vercel this has to be a hosted cluster (Atlas): mongodb+srv://...
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=deutschmate

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_dev_only_secret_do_not_ship
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=60

# --- Mail ---
# console = print the message to stdout (dev). smtp = actually send.
# console is dev-only: in production nobody could ever verify an email.
MAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@deutschmate.local

# --- App ---
APP_ENV=dev
# On Vercel: https://<project>.vercel.app — it is what verification and reset
# links are built from, so a wrong value sends users nowhere.
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*
EMAIL_VERIFICATION_REQUIRED=true

# --- Admin ---
# Required to publish content packages when APP_ENV=prod.
ADMIN_API_KEY=

# --- Federated sign-in ---
# Every OAuth client id that may appear as an ID token's `aud`, comma
# separated. Get these from Google Cloud Console > Credentials.
#   - Web client id: also used as `serverClientId` in the Flutter app
#   - Android client id: created against the package name + SHA-1 fingerprints
#   - iOS client id: when iOS ships
# Leave empty to disable Google sign-in entirely.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
