<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. Android 9+ blocks cleartext HTTP, so a dev build talking to a
  local FastAPI over http:// fails in a way that looks exactly like "the server
  is down". This permits cleartext to the loopback addresses only.

  10.0.2.2 is the host machine as seen from inside an Android emulator.

  Deliberately in src/debug: the release manifest has no cleartext permission,
  so a production build cannot silently talk plain HTTP.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
